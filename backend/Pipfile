[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
django = "~=4.2"
djangorestframework = "~=3.14"
# Serves static assets + the built SPA straight from Django (single-container Docker).
whitenoise = "~=6.6"
# Production WSGI server used by the Docker image (runserver stays for local dev).
gunicorn = "~=22.0"
# NOTE: Phase 1 uses SQLite (bundled with Python) — no external DB driver needed.
# psycopg2-binary is added in Phase 3 for the Postgres migration only.

[dev-packages]
ruff = "*"
pre-commit = "*"
# Pinned to a known-good combo: pytest-django 4.13 has an eager-setup regression.
pytest = ">=8,<9"
pytest-django = "==4.8.0"

[requires]
python_version = "3.11"

[scripts]
start = "python manage.py runserver 0.0.0.0:8000"
mm = "python manage.py makemigrations"
migrate = "python manage.py migrate"
test = "pytest"
